{
  "name": "commercehub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" run dev",
    "dev:storefront": "pnpm --filter @commercehub/storefront dev",
    "dev:admin": "pnpm --filter @commercehub/admin dev",
    "dev:api": "pnpm --filter @commercehub/api dev",
    "build": "pnpm --recursive --sort run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "node --test scripts/workspace.test.mjs",
    "check:architecture": "node --test scripts/workspace.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
