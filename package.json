{
  "name": "commercehub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:storefront": "pnpm --filter @commercehub/storefront dev",
    "dev:admin": "pnpm --filter @commercehub/admin dev",
    "dev:api": "pnpm --filter @commercehub/api dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "node --test scripts/scaffold.test.mjs scripts/workspace.test.mjs scripts/code-quality.test.mjs scripts/ci.test.mjs scripts/dependency-audit.test.mjs scripts/environment.test.mjs scripts/connectivity.test.mjs scripts/contracts.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check:architecture": "node --test scripts/workspace.test.mjs",
    "lint": "pnpm build:packages && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:quality": "node --test scripts/code-quality.test.mjs",
    "test:ci": "node --test scripts/ci.test.mjs scripts/dependency-audit.test.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "audit:ci": "node scripts/check-dependency-audit.mjs",
    "test:contracts": "node --test scripts/contracts.test.mjs",
    "build:packages": "pnpm --filter \"./packages/**\" -r --workspace-concurrency=1 build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@next/swc-wasm-nodejs": "16.4.2",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1"
  }
}
