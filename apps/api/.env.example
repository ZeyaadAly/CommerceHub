# Optional local API-only configuration; copy to apps/api/.env if desired.
# Shell environment wins over .env. Missing file is allowed. Restart after editing.
# PORT: nonsecret TCP port, integer 1-65535. Defaults to 3002 in development/test.
# Required when NODE_ENV=production; production startup is not deployment approval.
PORT=3002
# NODE_ENV: optional nonsecret Node mode: development (default), test, production.
NODE_ENV=development
# Optional technical JSON budget: integer bytes, 1..1048576. Deployment limits require review.
API_BODY_LIMIT_BYTES=102400
# No database, Redis, session or provider variables are implemented or required.
# Never put API environment values in Next.js configuration or public prefixes.
